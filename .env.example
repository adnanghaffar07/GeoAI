# Copy this file to `.env` and adjust. `.env` is never committed to Git.
# Values below are for LOCAL DEVELOPMENT ONLY. Use strong, unique values elsewhere.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (used by the `db` container and by the API) ---
POSTGRES_USER=geoinfralens
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=geoinfralens
# Host is `db` (the Docker service name). Keep the user/password in sync with the lines above.
DATABASE_URL=postgresql+psycopg://geoinfralens:local-dev-only-change-me@db:5432/geoinfralens

# Separate database used only by automated tests (created automatically, emptied after each test).
TEST_DATABASE_URL=postgresql+psycopg://geoinfralens:local-dev-only-change-me@db:5432/geoinfralens_test

# --- Job queue (Valkey) ---
REDIS_URL=redis://queue:6379/0

# --- Storage (inside the container; backed by the `storage-data` Docker volume) ---
STORAGE_DIR=/data/storage

# --- AI model ---
# Which detector analyses photos. "stand-in-0.1" is the TEST DETECTOR (made-up results, no file needed).
# "frcnn-rdd2022-0.1" is the TRIAL model (accuracy NOT approved): put frcnn-rdd2022-0.1.pt in ml/models/.
# To switch, change this line, then: docker compose restart api worker
ANALYSIS_MODEL_VERSION=stand-in-0.1

# --- Sign-in and security ---
# The address people use to open the app (used in invite/reset links and the Origin check).
PUBLIC_APP_URL=http://localhost:5173
# Keep true. Browsers treat http://localhost as secure, so sign-in works in development.
SESSION_COOKIE_SECURE=true
